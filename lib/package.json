{
  "name": "next-electron-rsc",
  "version": "0.3.0",
  "description": "Next.js + Electron + React Server Components",
  "main": "build/index.js",
  "main:src": "src/index.ts",
  "source": "src/index.ts",
  "types": "build/index.d.ts",
  "x-module": "build/index.js",
  "x-jsnext:main": "build/index.js",
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['build','.tscache']) fs.rmSync(path,{recursive:true,force:true})\"",
    "build": "tsc --build .",
    "test": "yarn build && node --test test/*.test.cjs",
    "start": "yarn build --watch --preserveWatchOutput",
    "prepublishOnly": "yarn test"
  },
  "license": "MIT",
  "dependencies": {
    "resolve": "^1.22.10",
    "set-cookie-parser": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/resolve": "^1.20.6",
    "@types/set-cookie-parser": "^2.4.10",
    "electron": "36.3.2",
    "next": "^15.3.3",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "electron": ">=30",
    "next": ">=14"
  },
  "author": "Kirill Konshin",
  "repository": {
    "type": "git",
    "url": "git://github.com/kirill-konshin/next-electron-rsc.git"
  },
  "bugs": {
    "url": "https://github.com/kirill-konshin/next-electron-rsc/issues"
  },
  "homepage": "https://github.com/kirill-konshin/next-electron-rsc"
}
