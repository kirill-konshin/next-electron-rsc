{
  "name": "next-electron-rsc",
  "version": "0.5.0",
  "description": "Next.js + Electron + React Server Components",
  "main": "build/index.js",
  "main:src": "src/index.ts",
  "source": "src/index.ts",
  "types": "build/index.d.ts",
  "x-module": "build/index.js",
  "x-jsnext:main": "build/index.js",
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf build .tscache",
    "build": "vp pack",
    "start": "vp pack --watch",
    "wait": "wait-on ./build/index.js",
    "test": "vp test run",
    "prepublishOnly": "yarn build"
  },
  "license": "MIT",
  "dependencies": {
    "resolve": "^1.22.10",
    "set-cookie-parser": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/resolve": "^1.20.6",
    "@types/set-cookie-parser": "^2.4.10",
    "electron": "36.3.2",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^6.0.3",
    "vite-plus": "^1.3.0",
    "wait-on": "^8.0.3"
  },
  "peerDependencies": {
    "electron": ">=30",
    "next": ">=14"
  },
  "author": "Kirill Konshin",
  "repository": {
    "type": "git",
    "url": "git://github.com/kirill-konshin/next-electron-rsc.git"
  },
  "bugs": {
    "url": "https://github.com/kirill-konshin/next-electron-rsc/issues"
