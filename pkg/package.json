{
  "name": "next-pkg",
  "version": "1.0.0",
  "description": "demo",
  "private": true,
  "main": "next.config.ts",
  "bin": "pkgServer.cjs",
  "scripts": {
    "clean": "rm -rf .next out",
    "start": "next dev --turbo",
    "build:all": "yarn clean && yarn build:next && yarn build:pkg",
    "build:next": "next build",
    "build:pkg": "mkdir -p out && cd .next/standalone/pkg && pkg . --compress=GZip -t node26-macos-arm64",
    "open": "./out/next-pkg"
  },
  "license": "ISC",
  "dependencies": {
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "18.3.20",
    "@types/react-dom": "^18.3.6",
    "@yao-pkg/pkg": "^6.23.0",
    "typescript": "^6.0.3"
  },
  "pkg": {
    "assets": [
      ".next/**/*",
      "public/**/*.*"
    ],
    "outputPath": "../../../out"
  }
}
