{
  "name": "next-electron-rsc-monorepo",
  "version": "1.0.0",
  "description": "demo",
  "private": true,
  "scripts": {
    "postinstall": "lint-prepare init && vp config",
    "clean": "vp run -r clean && rm -rf node_modules",
    "build": "vp run -r build",
    "start": "vp run -r --parallel start",
    "test": "vp run -r test",
    "lint": "vp check --fix",
    "lint:staged": "vp staged"
  },
  "author": "kirill.konshin",
  "license": "ISC",
  "devDependencies": {
    "@kirill.konshin/lint": "^0.7.1",
    "@yarnpkg/types": "^4.0.1",
    "cross-env": "^7.0.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
    "vite-plus": "^1.3.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "packageManager": "yarn@4.18.1",
  "workspaces": {
    "packages": [
      "demo",
      "lib",
      "pkg",
      "sea"
    ]
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
    "vitest": "5.0.5"
  }
